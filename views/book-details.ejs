<!DOCTYPE html>
<html>
<head>
  <title><%= book.title %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/header') %>
  <h1><%= book.title %></h1>
  <p>by <%= book.authors %></p>
  <img src="<%= book.image_url %>" alt="<%= book.title %>">
  <p>Rating: <%= book.average_rating %></p>
  <% if (userId) { %>
  <form method="POST" action="/books/<%= book.book_id %>/shelf">
    <select name="status">
      <option value="tbr" <%= userBook && userBook.status === 'tbr' ? 'selected' : '' %>>Want to Read</option>
      <option value="reading" <%= userBook && userBook.status === 'reading' ? 'selected' : '' %>>Currently Reading</option>
      <option value="read" <%= userBook && userBook.status === 'read' ? 'selected' : '' %>>Read</option>
    </select>
   <input type="number" name="total_pages" placeholder="Total pages (optional)" value="<%= userBook && userBook.total_pages ? userBook.total_pages : '' %>">
   <button type="submit"><%= userBook ? 'Update' : 'Add to Shelf' %></button>
  </form>
<% } %>
<% if (userId) { %>
  <form method="POST" action="/books/<%= book.book_id %>/progress">
    <input type="number" name="current_page" placeholder="Current page" value="<%= userBook && userBook.current_page ? userBook.current_page : '' %>">
    <button type="submit">Update Progress</button>
  </form>
<% } %>

  <h2>You might also like</h2>
  <div class="grid">
    <% recommendations.forEach(rec => { %>
      <div class="book-card">
        <a href="/books/<%= rec.book_id %>">
          <img src="<%= rec.image_url %>" alt="<%= rec.title %>">
          <p><%= rec.title %></p>
        </a>
      </div>
    <% }) %>
  </div>

  <a href="/">← Back to books</a>
</body>
</html>