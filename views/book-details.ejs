<!DOCTYPE html>
<html>
<head>
  <title><%= book.title %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/header') %>
  <h1><%= book.title %></h1>
  <p>by <%= book.authors %></p>
  <img src="<%= book.image_url %>" alt="<%= book.title %>">
  <p>Rating: <%= book.average_rating %></p>
  <% if (userId) { %>
  <form method="POST" action="/books/<%= book.book_id %>/shelf">
    <select name="status">
      <option value="tbr" <%= userBook && userBook.status === 'tbr' ? 'selected' : '' %>>Want to Read</option>
      <option value="reading" <%= userBook && userBook.status === 'reading' ? 'selected' : '' %>>Currently Reading</option>
      <option value="read" <%= userBook && userBook.status === 'read' ? 'selected' : '' %>>Read</option>
    </select>
   <input type="number" name="total_pages" placeholder="Total pages (optional)" value="<%= userBook && userBook.total_pages ? userBook.total_pages : '' %>">
   <button type="submit"><%= userBook ? 'Update' : 'Add to Shelf' %></button>
  </form>
<% } %>
<% if (userId) { %>
  <form method="POST" action="/books/<%= book.book_id %>/progress">
    <input type="number" name="current_page" placeholder="Current page" value="<%= userBook && userBook.current_page ? userBook.current_page : '' %>">
    <button type="submit">Update Progress</button>
  </form>
<% } %>
<% if (userId) { %>
  <% if (myReview) { %>
    <div class="review my-review">
      <p><strong>Your review</strong> — <%= myReview.rating %>/5</p>
      <% if (myReview.review_text) { %><p><%= myReview.review_text %></p><% } %>
      <details>
        <summary>Edit review</summary>
        <form method="POST" action="/books/<%= book.book_id %>/review">
          <select name="rating">
            <option value="5" <%= myReview.rating === 5 ? 'selected' : '' %>>5 - Loved it</option>
            <option value="4" <%= myReview.rating === 4 ? 'selected' : '' %>>4 - Really liked it</option>
            <option value="3" <%= myReview.rating === 3 ? 'selected' : '' %>>3 - Liked it</option>
            <option value="2" <%= myReview.rating === 2 ? 'selected' : '' %>>2 - It was okay</option>
            <option value="1" <%= myReview.rating === 1 ? 'selected' : '' %>>1 - Didn't like it</option>
          </select><br>
          <textarea name="review_text" rows="4"><%= myReview.review_text %></textarea><br>
          <button type="submit">Update Review</button>
        </form>
      </details>
    </div>
  <% } else { %>
    <h2>Write a Review</h2>
    <form method="POST" action="/books/<%= book.book_id %>/review">
      <select name="rating">
        <option value="5">5 - Loved it</option>
        <option value="4">4 - Really liked it</option>
        <option value="3">3 - Liked it</option>
        <option value="2">2 - It was okay</option>
        <option value="1">1 - Didn't like it</option>
      </select><br>
      <textarea name="review_text" rows="4" placeholder="Write your thoughts..."></textarea><br>
      <button type="submit">Submit Review</button>
    </form>
  <% } %>
<% } %>
<h2>Reviews</h2>
<% if (reviews.length === 0) { %>
  <p>No reviews yet — be the first!</p>
<% } else { %>
 <% reviews.forEach(r => { %>
  <% if (r.username !== username) { %>
    <div class="review">
      <p><strong><%= r.username %></strong> — <%= r.rating %>/5</p>
      <% if (r.review_text) { %><p><%= r.review_text %></p><% } %>
    </div>
  <% } %>
<% }) %>
<% } %>

  <h2>You might also like</h2>
  <div class="grid">
    <% recommendations.forEach(rec => { %>
      <div class="book-card">
        <a href="/books/<%= rec.book_id %>">
          <img src="<%= rec.image_url %>" alt="<%= rec.title %>">
          <p><%= rec.title %></p>
        </a>
      </div>
    <% }) %>
  </div>

  <a href="/">← Back to books</a>
</body>
</html>