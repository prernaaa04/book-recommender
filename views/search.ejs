<!DOCTYPE html>
<html>
<head>
  <title>Search Books</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/header') %>

  <h1>Search Books</h1>
  <form method="GET" action="/search">
    <input type="text" name="q" placeholder="Search by title or author..." value="<%= query %>">
    <button type="submit">Search</button>
  </form>

  <% if (query && books.length === 0) { %>
    <p>No books found for "<%= query %>"</p>
  <% } %>

  <div class="grid">
    <% books.forEach(book => { %>
      <div class="book-card">
        <a href="/books/<%= book.book_id %>">
           <img src="<%= book.isbn ? `https://covers.openlibrary.org/b/isbn/${book.isbn}-L.jpg` : book.image_url %>" alt="<%= book.title %>" onload="if(this.naturalWidth < 5) { this.src='<%= book.image_url %>'; }">
          <p><%= book.title %></p>
        </a>
      </div>
    <% }) %>
  </div>
  <div class="pagination">
  <% if (page > 1) { %>
    <a href="/search?q=<%= query %>&page=<%= page - 1 %>">← Previous</a>
  <% } %>
  <% if (totalPages > 0) { %>
    <span>Page <%= page %> of <%= totalPages %></span>
  <% } %>
  <% if (page < totalPages) { %>
    <a href="/search?q=<%= query %>&page=<%= page + 1 %>">Next →</a>
  <% } %>
</div>
</body>
</html>