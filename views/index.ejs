<!DOCTYPE html>
<html>
<head>
  <title>Book Recommender</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/header') %>
  <h1>Books</h1>
 
  <div class="grid">
    <% books.forEach(book => { %>
      <div class="book-card">
        <a href="/books/<%= book.book_id %>">
          <img src="<%= book.image_url %>" alt="<%= book.title %>">
          <p><%= book.title %></p>
        </a>
      </div>
      
    <% }) %>
  </div>
</body>
</html>